# Copy to .env and fill in only the providers you actually use.
# HexSwarm routes through LiteLLM, so any provider it supports works here.

# --- Model selection (LiteLLM "provider/model" strings) ---
HEXSWARM_PRIMARY_MODEL=ollama/llama3.1
HEXSWARM_FALLBACK_MODELS=anthropic/claude-sonnet-5,openai/gpt-4o

# --- Provider credentials (only set what you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama needs no API key, just a running local server (default http://localhost:11434)
OLLAMA_API_BASE=http://localhost:11434

# --- Behavior ---
HEXSWARM_HITL=false
HEXSWARM_TEMPERATURE=0.2
HEXSWARM_MAX_STEPS=6

# --- Per-tool-call Docker sandboxing (default: host, no sandboxing) ---
# HEXSWARM_SANDBOX=docker
# HEXSWARM_SANDBOX_IMAGE=ghcr.io/farhan6667/hexswarm-toolchain:latest
# HEXSWARM_SANDBOX_NETWORK=none
