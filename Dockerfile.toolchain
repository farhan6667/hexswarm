# The real pentest-toolchain image: this is what HEXSWARM_SANDBOX_IMAGE points
# at by default (see src/hexswarm/tools/sandbox.py), and what `docker run
# ghcr.io/farhan6667/hexswarm-toolchain hexswarm tools` reports every tool as
# actually installed against, instead of simulate mode.
#
# Build:   docker build -f Dockerfile.toolchain -t hexswarm-toolchain .
# Smoke:   docker run --rm hexswarm-toolchain hexswarm tools
#
# This is deliberately a *separate* image from the plain Dockerfile: most
# people running HexSwarm don't need a 1+ GB Kali-based image with a full
# exploit toolchain just to orchestrate agents, and CI builds/smoke-tests
# this one on its own schedule (see .github/workflows/toolchain-image.yml)
# since it's slow to build and not something every push needs to rebuild.

FROM kalilinux/kali-rolling

LABEL org.opencontainers.image.source="https://github.com/farhan6667/hexswarm" \
      org.opencontainers.image.description="HexSwarm with the real offensive-security toolchain installed (nmap, nuclei, gobuster, sqlmap, hydra, metasploit, searchsploit, whois, subfinder, amass, whatweb, dalfox, file, binutils, hashid)." \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.authors="Syed Farhan Ahmed (SFA), NexaForge"

ENV DEBIAN_FRONTEND=noninteractive

# kali-rolling's default sources.list points at http.kali.org, a GeoIP redirector that can
# hand out a flaky regional mirror (seen in CI: mirror.us.cdn-perfprod.com timing out mid
# apt-get install, after apt-get update had already succeeded against it). apt itself has no
# per-package mirror fallback once a transfer starts failing partway through a batch, so this
# retries the whole update+install a few times with a short backoff, which is what actually
# recovers from a transient failure on one specific mirror rather than a config that still
# depends on that same mirror being reliable from the first byte to the last.
RUN apt-get update -o Acquire::Retries=5 -o Acquire::http::Timeout=30 && \
    ok=0; \
    for attempt in 1 2 3 4 5; do \
        if apt-get install -y --no-install-recommends -o Acquire::Retries=5 -o Acquire::http::Timeout=30 \
            python3 python3-pip python3-venv \
            nmap \
            nuclei \
            gobuster \
            sqlmap \
            hydra \
            metasploit-framework \
            exploitdb \
            whois \
            subfinder \
            amass \
            whatweb \
            dalfox \
            binutils \
            file \
            hashid; \
        then ok=1; break; fi; \
        echo "apt-get install attempt $attempt failed, retrying in 15s..."; \
        sleep 15; \
        apt-get update -o Acquire::Retries=5 -o Acquire::http::Timeout=30; \
    done; \
    test "$ok" = "1" \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash hexswarm
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --break-system-packages .

USER hexswarm
WORKDIR /work

ENTRYPOINT ["hexswarm"]
CMD ["--help"]
